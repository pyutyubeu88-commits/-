# Anthropic Claude API — content_generate.py 에서 사용
ANTHROPIC_API_KEY=sk-ant-...

# (선택) 콘텐츠 생성 모델 오버라이드. 비워두면 claude-sonnet-5 사용
# ANTHROPIC_MODEL=claude-sonnet-5

# (선택) 텔레그램 알림 — 발행 완료/실패/이상 감지 시 알림 전송
# 둘 다 비워두면 콘솔 출력으로만 대체된다
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 하루 최대 발행 개수 (안전장치, 기본 1개)
MAX_POSTS_PER_DAY=1
